APP_NAME="QSTrack SAT"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://qstrack-sat.test
APP_TIMEZONE=America/Guatemala

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=qstrack_sat
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---- SAT ----
# farm3 es el único ambiente accesible de la SAT y el que usa el sistema en
# operación. El host prefarm3 que aparece en los formularios de ejemplo de la
# SAT responde 403 y nunca estuvo en uso.
SAT_ENVIRONMENT=produccion
SAT_BASE_URL=https://farm3.sat.gob.gt/manifiestos/rest/receptorCuscar/
SAT_TIMEOUT=30
SAT_CONNECT_TIMEOUT=10
SAT_RETRY_TIMES=2
SAT_RETRY_SLEEP_MS=500
SAT_VERIFY_SSL=true
SAT_HEALTHCHECK_TTL=60
SAT_HEALTHCHECK_TIMEOUT=3
SAT_PROCESAMIENTO_SINCRONO=false
SAT_CUSCAR_MAX_BYTES=1240000
SAT_STORE_RAW_RESPONSE=true
SAT_RAW_RESPONSE_MAX_CHARS=20000
